{
  "name": "traccia-cli",
  "version": "0.0.0",
  "description": "CLI and MCP server for Traccia: read recordings, start and stop the recorder from a terminal or from an AI agent",
  "license": "MIT",
  "author": "Francesco Sganga",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francescosganga/traccia.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/francescosganga/traccia#cli--mcp",
  "bin": {
    "traccia": "./dist/traccia.cjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
