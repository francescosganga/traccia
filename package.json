{
  "name": "traccia",
  "version": "0.1.0",
  "description": "Traccia — screen recorder that produces AI-readable output: video or frames + cursor/click timeline + local Whisper transcript",
  "main": "./out/main/index.js",
  "author": "Francesco Sganga",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francescosganga/traccia.git"
  },
  "homepage": "https://github.com/francescosganga/traccia#readme",
  "bugs": {
    "url": "https://github.com/francescosganga/traccia/issues"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --mac --config electron-builder.yml",
    "link": "electron-vite build && electron-builder --mac --dir --$(uname -m | sed s/x86_64/x64/) --config electron-builder.yml && node scripts/link-app.cjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@huggingface/transformers": "^4.3.0",
    "ffmpeg-static": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vitest": "^3.2.7"
  }
}
