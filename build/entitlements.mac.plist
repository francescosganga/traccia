<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron under the hardened runtime: V8 JIT and unsigned executable memory. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Native modules (uiohook-napi, onnxruntime-node, sharp) are loaded from app.asar.unpacked. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Microphone: without this the hardened runtime denies audio input silently. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
